name": "other", "slug": "other"}, {"id": 358, "name": "test", "slug": "test"}], "tags_descriptions": {}, "like_count": 0, "views": 691, "category_id": 6, "featured_link": null, "op_like_count": 0, "has_accepted_answer": true, "posters": [{"extras": null, "description": "Original Poster", "user": {"id": 52493, "username": "felix4", "name": "Felix", "avatar_template": "/user_avatar/community.auth0.com/felix4/{size}/61986_2.png", "trust_level": 1}}, {"extras": "latest", "description": "Most Recent Poster, Accepted Answer", "user": {"id": 76022, "username": "nik.baleca", "name": "Nikita Baleca", "avatar_template": "/user_avatar/community.auth0.com/nik.baleca/{size}/68749_2.png", "primary_group_name": "DeveloperHubMembers", "flair_name": "DeveloperHubMembers", "flair_group_id": 75, "admin": true, "moderator": true, "trust_level": 4}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 23384, "username": "Hawxy", "name": "JT", "avatar_template": "/user_avatar/community.auth0.com/hawxy/{size}/21395_2.png", "trust_level": 2}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 56318, "username": "john22", "name": "John Anderson", "avatar_template": "/user_avatar/community.auth0.com/john22/{size}/54605_2.png", "trust_level": 1}}, {"extras": null, "description": "Frequent Poster", "user": {"id": -1, "username": "system", "name": "system", "avatar_template": "https://global.discourse-cdn.com/auth0/original/3X/b/5/b560f266932fcce5d57f09a6595bd50518cae3f3.jpeg", "admin": true, "moderator": true, "trust_level": 4}}]}, {"fancy_title": "Auth0 password grant with organization", "id": 80278, "title": "Auth0 password grant with organization", "slug": "auth0-password-grant-with-organization", "posts_count": 6, "reply_count": 3, "highest_post_number": 8, "image_url": "https://global.discourse-cdn.com/auth0/optimized/3X/5/2/5284a82f1a02fa912d3c17d86589f1448eac8ca2_2_1024x919.png", "created_at": "2022-03-21T22:17:42.420Z", "last_posted_at": "2026-02-25T17:58:37.242Z", "bumped": true, "bumped_at": "2026-02-25T17:58:37.242Z", "archetype": "regular", "unseen": false, "pinned": false, "unpinned": null, "visible": true, "closed": true, "archived": false, "bookmarked": null, "liked": null, "tags": [{"id": 1574, "name": "organizations", "slug": "organizations"}, {"id": 157, "name": "password", "slug": "password"}, {"id": 106, "name": "testing", "slug": "testing"}], "tags_descriptions": {}, "like_count": 3, "views": 4388, "category_id": 6, "featured_link": null, "op_like_count": 0, "has_accepted_answer": true, "posters": [{"extras": null, "description": "Original Poster", "user": {"id": 36605, "username": "billyf", "name": "", "avatar_template": "/user_avatar/community.auth0.com/billyf/{size}/33224_2.png", "trust_level": 1}}, {"extras": "latest", "description": "Most Recent Poster, Accepted Answer", "user": {"id": 76022, "username": "nik.baleca", "name": "Nikita Baleca", "avatar_template": "/user_avatar/community.auth0.com/nik.baleca/{size}/68749_2.png", "primary_group_name": "DeveloperHubMembers", "flair_name": "DeveloperHubMembers", "flair_group_id": 75, "admin": true, "moderator": true, "trust_level": 4}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 15638, "username": "rueben.tiow", "name": "Rueben Tiow", "avatar_template": "/user_avatar/community.auth0.com/rueben.tiow/{size}/11646_2.png", "trust_level": 2}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 23384, "username": "Hawxy", "name": "JT", "avatar_template": "/user_avatar/community.auth0.com/hawxy/{size}/21395_2.png", "trust_level": 2}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 13218, "username": "konrad.sopala", "name": "Konrad", "avatar_template": "/user_avatar/community.auth0.com/konrad.sopala/{size}/13516_2.png", "trust_level": 2}}]}], "summarizable": false, "has_cached_summary": false, "accepted_answers": [{"id": 470414, "username": "nik.baleca", "avatar_template": "/user_avatar/community.auth0.com/nik.baleca/{size}/68749_2.png", "created_at": "2026-02-25T18:00:15.494Z", "cooked": "<p>Hi everyone!</p>\n<p>In the context of performing automated tests in the context of organizations, it can be a difficult task since the usual <a href=\"https://auth0.com/docs/get-started/authentication-and-authorization-flow/resource-owner-password-flow\">ROPG grant flow</a> cannot be enabled.</p>\n<p>However, this can be resolved by using a <a href=\"https://auth0.com/docs/customize/actions/explore-triggers/signup-and-login-triggers/custom-token-exchange-trigger\">Custom Token Exchange Trigger</a> in which you will be able to set the organization as seen in this <a href=\"https://auth0.com/docs/customize/actions/explore-triggers/signup-and-login-triggers/custom-token-exchange-trigger/custom-token-exchange-api-object#api-authentication-setorganization-organization\">example</a>:</p>\n<pre><code class=\"lang-auto\">exports.onExecuteCustomTokenExchange = async (event, api) =&gt; {\n\n  // 1. Validate subject_token\n  const subject_token = await validateToken(event.transaction.subject_token, jwksUri);\n\n  // 2.  Apply your authorization policy on the user\n  const isAuthorized = await authorizeAccess(subject_token.sub);\n  if (!isAuthorized) {\n    api.access.deny('Unauthorized_login', 'User cannot login due to reason: X');\n  }\n\n  // 3. Set the user for the transaction\n  api.authentication.setOrginzation('org_xS525r979AS33MSf');\n\n  // 4. Set the user for the transaction. You may also use setUserByConnection()\n  api.authentication.setUserById(subject_token.sub);\n\n  return;\n};\n</code></pre>\n<p>Hope this helps anybody who stumbles across the same issue!</p>\n<p>Kind Regards,<br>\nNik</p>", "post_number": 8, "topic_id": 102885, "url": "/t/add-org-id-to-access-token-returned-from-resource-owner-password-flow/102885/8"}], "has_accepted_answer": true, "can_create_shared_issue": false, "shared_issue_visible": false, "can_vote": false, "vote_count": 0, "user_voted": false, "discourse_zendesk_plugin_zendesk_id": null, "discourse_zendesk_plugin_zendesk_url": "https://your-url.zendesk.com/agent/tickets/", "details": {"can_edit": false, "notification_level": 1, "participants": [{"id": 36825, "username": "ty.frith", "name": "Ty", "avatar_template": "/user_avatar/community.auth0.com/ty.frith/{size}/58484_2.png", "post_count": 2, "primary_group_name": "Auth0_Employees", "flair_name": "Auth0_Employees", "flair_url": "https://global.discourse-cdn.com/auth0/original/3X/d/c/dcd65ed8da0dd06e82c3ae1047aeab4c87f18097.jpeg", "flair_color": "", "flair_bg_color": "00000", "flair_group_id": 41, "trust_level": 4}, {"id": 43338, "username": "simon17", "name": "Simon Chen", "avatar_template": "/user_avatar/community.auth0.com/simon17/{size}/33814_2.png", "post_count": 2, "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_color": null, "flair_bg_color": null, "flair_group_id": null, "trust_level": 1}, {"id": 76022, "username": "nik.baleca", "name": "Nikita Baleca", "avatar_template": "/user_avatar/community.auth0.com/nik.baleca/{size}/68749_2.png", "post_count": 1, "primary_group_name": "DeveloperHubMembers", "flair_name": "DeveloperHubMembers", "flair_url": null, "flair_color": "", "flair_bg_color": "", "flair_group_id": 75, "admin": true, "moderator": true, "trust_level": 4}], "created_by": {"id": 43338, "username": "simon17", "name": "Simon Chen", "avatar_template": "/user_avatar/community.auth0.com/simon17/{size}/33814_2.png"}, "last_poster": {"id": 76022, "username": "nik.baleca", "name": "Nikita Baleca", "avatar_template": "/user_avatar/community.auth0.com/nik.baleca/{size}/68749_2.png"}, "links": [{"url": "https://auth0.com/docs/secure/tokens/json-web-tokens/create-custom-claims#general-restrictions", "title": "Create Custom Claims", "internal": false, "attachment": false, "reflection": false, "clicks": 22, "user_id": 36825, "domain": "auth0.com", "root_domain": "auth0.com"}]}, "bookmarks": []}